rules_version = '2';

// Dr. Cahit Cenksoy IVF — Firestore güvenlik kuralları
//
// Model:
//  - Ziyaretçiler (giriş yapmamış) yalnız herkese açık içeriği OKUR (team, blog, faqs, settings).
//  - Yazma/güncelleme/silme YALNIZCA yönetici (admin) hesaplarına açıktır.
//  - Admin = giriş yapmış ve `admins/{uid}` dökümanı bulunan kullanıcı.
//    Yeni admin eklemek için: Firebase Console > Authentication'dan kullanıcı oluştur,
//    sonra Firestore'da `admins` koleksiyonuna ID'si o kullanıcının UID'i olan bir döküman ekle.
//  - `admins` koleksiyonuna client'tan YAZILAMAZ (yalnız Console/Admin SDK ile yönetilir).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Herkese açık içerik: ziyaretçi okur, yalnız admin yazar
    match /team/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Blog: okuma herkese açık (public blog listesi status filtresi olmadan sorgu attığından
    // ve where+orderBy bileşik index gerektireceğinden kural seviyesinde 'true' bırakıldı).
    // Taslak içeriğin GÖSTERİMİ blog-post.html'de status kontrolüyle engelleniyor.
    // Yazma yalnız admin.
    match /blog/{id} { allow read: if true; allow write: if isAdmin(); }

    // Admin allowlist: yalnız adminler okuyabilir, hiç kimse client'tan yazamaz.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Diğer her şey kapalı (varsayılan reddet).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

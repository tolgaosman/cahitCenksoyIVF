# ============================================================================
#  Dr. Cahit Cenksoy IVF — Render BACKEND ortam değişkenleri (ÖRNEK)
# ----------------------------------------------------------------------------
#  Bu dosya commit edilir; GERÇEK değerleri ASLA buraya yazma.
#  Gerçek sırlar:
#    - Yerelde: kök dizine `.env` olarak kopyala ve doldur (git'e GİTMEZ).
#    - Render'da: Dashboard > Service > Environment > "Environment Variables"
#      bölümünden ekle (kod tabanına yazma).
# ============================================================================

# --- Çalışma ortamı ---
NODE_ENV=production
PORT=3000

# --- CORS: izin verilen origin'ler (virgülle ayır, WILDCARD yok) ---
# GitHub Pages domainin + yerel geliştirme adresin
ALLOWED_ORIGINS=https://KULLANICI_ADIN.github.io,http://localhost:3000,http://localhost:5173

# --- Firebase Admin SDK (sunucu tarafı; client apiKey'den FARKLI) ---
# Service account JSON'unu tek satıra sıkıştırıp buraya koy YA DA dosya yolunu ver.
FIREBASE_PROJECT_ID=in-vitro-fertilization-154m9k
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@in-vitro-fertilization-154m9k.iam.gserviceaccount.com
# \n kaçışlarını koru; tırnak içinde tek satır:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- JWT / oturum ---
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"` ile üret
JWT_SECRET=BURAYA_UZUN_RASTGELE_GIZLI_ANAHTAR
JWT_EXPIRES_IN=2h
COOKIE_DOMAIN=cahit-cenksoy-admin.onrender.com

# --- Şifre sıfırlama token ömrü (dakika) ---
RESET_TOKEN_TTL_MINUTES=30

# --- Breach / alert webhook (Discord veya Slack incoming webhook URL) ---
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy
# Ardışık başarısız giriş eşiği (bu sayıyı aşınca alarm)
ALERT_FAIL_THRESHOLD=5
